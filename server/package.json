{
  "name": "@judytik/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:database": "tsx test/run-database-tests.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:grants": "node scripts/apply-runtime-grants.mjs",
    "build": "tsc",
    "api:generate": "tsx scripts/generate-openapi.ts",
    "gifts:sync": "tsx scripts/sync-gifts.ts",
    "contracts:generate": "tsx scripts/generate-contracts.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "17.2.3",
    "express-rate-limit": "8.3.1",
    "jose": "6.2.13",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "openapi-typescript": "7.13.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
