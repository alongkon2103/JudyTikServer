            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "const r=pm.response.json(); pm.test('Mutation recorded',()=>pm.expect(r.operation.id).to.be.a('string')); pm.test('Fresh operation',()=>pm.expect(r.replayed).to.eql(false));",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "08 - Verify current rights",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/entitlements?userId={{userId}}",
        "description": "08 - Verify current rights"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "pm.test('FREE or PRO',()=>pm.expect(pm.response.json().entitlement.plan).to.be.oneOf(['FREE','PRO']));",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "09 - Latest history (2 per page)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/entitlements/history?userId={{userId}}&limit=2",
        "description": "09 - Latest history (2 per page)"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "const r=pm.response.json();pm.environment.set('nextCursor',r.nextCursor||'');pm.test('Bounded history',()=>pm.expect(r.items.length).to.be.at.most(2));",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "10 - Next history page",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/entitlements/history?userId={{userId}}&limit=2&before={{nextCursor}}",
        "description": "10 - Next history page"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(!pm.environment.get('nextCursor'))throw new Error('No next page; send request 09 after at least 3 operations');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "const r=pm.response.json();pm.environment.set('nextCursor',r.nextCursor||'');",
              "}"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
