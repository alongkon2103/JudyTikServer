            },
            {
              "key": "presetName",
              "value": "ชุดเสริม",
              "type": "text"
            },
            {
              "key": "status",
              "value": "draft",
              "type": "text"
            },
            {
              "key": "isDefault",
              "value": "false",
              "type": "text"
            },
            {
              "key": "presetFile",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('extraPresetId', pm.response.json().preset.id);"
            ]
          }
        }
      ]
    },
