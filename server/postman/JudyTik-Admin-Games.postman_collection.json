              "  const fields = [\"slug\",\"name\",\"description\",\"categoryId\",\"platform\",\"coverUrl\",\"url\",\"status\",\"sortOrder\",\"metadata\"];",
              "  pm.collectionVariables.set('gameWriteBody', JSON.stringify(Object.fromEntries(fields.map(k => [k, value[k]])), null, 2));",
              "}"
            ]
          }
        }
      ]
    },
