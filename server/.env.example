NODE_ENV=development
HOST=127.0.0.1
PORT=4300
# Use loopback only behind a local reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
# Dev: Supabase transaction pooler 6543. Production: your PostgreSQL server + restricted runtime role.
DATABASE_URL="postgresql://judytik_runtime.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=verify-full"
# Migrations only: Supabase session pooler 5432 in dev; your migration-role connection in production.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full"
# Random 32+ character service credential; admin backend/CLI only, never Desktop or browser code.
ADMIN_API_KEY=YOUR_RANDOM_ADMIN_SERVICE_KEY

# Supabase dev CA when required (public certificate, not a secret): append
# &sslrootcert=certs/supabase-ca.crt to URLs with sslmode=verify-full.

# Server-only persistent auth keys. Generate Ed25519 PKCS8 DER as base64;
# use independent random 32-byte base64url keys for the three shared-secret fields.
# Leave ALL auth secrets empty to disable authentication while keeping Gifts available.
API_ORIGIN=http://127.0.0.1:4300
AUTH_SIGNING_PRIVATE_KEY=
AUTH_SIGNING_KEY_ID=judytik-auth-v1
AUTH_ENCRYPTION_KEY=
AUTH_BROWSER_SECRET=
EMAIL_CODE_PEPPER=
# Add credentials when OAuth apps are registered; keep both fields empty until then.
# Exact callbacks: ${API_ORIGIN}/v1/auth/oauth/google/callback and /discord/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# smtp://USER:URL_ENCODED_PASSWORD@HOST:587 (STARTTLS required) or smtps://...:465
SMTP_URL=
SMTP_FROM=

# Optional server-only Euler signing. Leave BOTH blank for anonymous community mode.
# Configure BOTH for short-lived Desktop JWTs; never put the raw key in Electron/renderer.
EULER_API_KEY=
EULER_ACCOUNT_ID=

# Server-only JudyShop integration; leave blank until shop is deployed. Presets remain locked.
JUDYSHOP_BASE_URL=
JUDYTIK_SHOP_SERVICE_KEY=
