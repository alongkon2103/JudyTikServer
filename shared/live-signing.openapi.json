{
  "openapi": "3.1.1",
  "info": {
    "title": "JudyTik Desktop live signing authorization",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "LiveAuthorizationRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9._]{2,24}$"
          }
        },
        "required": [
          "username"
        ],
        "additionalProperties": false
      },
      "LiveAuthorization": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "const": "community"
              },
              "username": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._]{2,24}$"
              }
            },
            "required": [
              "mode",
              "username"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "const": "jwt"
              },
              "username": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._]{2,24}$"
              },
              "token": {
                "type": "string",
                "minLength": 20,
                "maxLength": 8192,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "mode",
              "username",
              "token",
              "expiresAt"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
